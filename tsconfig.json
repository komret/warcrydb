{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	}
	// Recommended options (moduleResolution, allowJs, checkJs, skipLibCheck, ...) come from $app/tsconfig.
	// Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
	// and #lib by the "imports" field in package.json
}
